
"""
Universal closed-form IK solver using DH parameters (θ, d, a, α).
Supports unknowns in θ, d, and α. Throws an error if no closed-form solution exists.

Dependencies:
    pip install sympy numpy
"""

from sympy import symbols, Matrix, cos, sin, simplify, Eq, solve, Symbol
from typing import List, Optional, Union
import numpy as np

class DHParam:
    """
    Denavit–Hartenberg parameter set for one link:
      θ   – joint angle (None if unknown)
      d   – link offset (None if unknown)
      a   – link length (must be known/fixed)
      α   – link twist (None if unknown)
    """
    def __init__(self,
                 theta: Optional[Union[float, Symbol]],
                 d:     Optional[Union[float, Symbol]],
                 a:     float,
                 alpha: Optional[Union[float, Symbol]]):
        self.theta = theta
        self.d     = d
        self.a     = a
        self.alpha = alpha

    def __repr__(self):
        return (f"DHParam(theta={self.theta}, d={self.d}, "
                f"a={self.a}, alpha={self.alpha})")

def dh_transform(theta, d, a, alpha):
    """Compute the homogeneous transform matrix from DH parameters."""
    return Matrix([
        [cos(theta), -sin(theta)*cos(alpha),  sin(theta)*sin(alpha), a*cos(theta)],
        [sin(theta),  cos(theta)*cos(alpha), -cos(theta)*sin(alpha), a*sin(theta)],
        [0,           sin(alpha),             cos(alpha),            d          ],
        [0,           0,                      0,                     1          ]
    ])

def solve_closed_ik(
    dh_params:       List[DHParam],
    target_pos:      Optional[List[float]] = None,
    target_matrix:   Optional[Matrix]       = None
) -> List[DHParam]:
    """
    Solve for unknown θ, d, and/or α in dh_params so that the end-effector
    reaches target_pos [x,y,z] or matches target_matrix (4×4).
    Returns a new list of DHParam with solved numerical values, or raises ValueError.
    """
    # Build forward kinematics symbolically
    T_total = Matrix(np.eye(4))
    joint_syms: List[tuple] = []  # (θ_sym or None, d_sym or None, α_sym or None)

    for i, p in enumerate(dh_params):
        # create symbols where parameters are unknown
        θ_sym   = Symbol(f"θ{i+1}") if p.theta is None else None
        d_sym   = Symbol(f"d{i+1}") if p.d     is None else None
        α_sym   = Symbol(f"α{i+1}") if p.alpha is None else None

        # use symbolic or numeric values
        θ_val   = θ_sym   if θ_sym   is not None else p.theta
        d_val   = d_sym   if d_sym   is not None else p.d
        α_val   = α_sym   if α_sym   is not None else p.alpha

        joint_syms.append((θ_sym, d_sym, α_sym))
        T_total = T_total @ dh_transform(θ_val, d_val, p.a, α_val)

    # build equation list
    eqs = []
    if target_matrix is not None:
        for r in range(3):
            for c in range(4):
                eqs.append(Eq(simplify(T_total[r, c]), simplify(target_matrix[r, c])))
    elif target_pos is not None:
        x, y, z = target_pos
        eqs += [
            Eq(simplify(T_total[0, 3]), x),
            Eq(simplify(T_total[1, 3]), y),
            Eq(simplify(T_total[2, 3]), z),
        ]
    else:
        raise ValueError("Provide either target_pos or target_matrix")

    # collect unknown symbols
    unknowns = []
    for θ_sym, d_sym, α_sym in joint_syms:
        if θ_sym is not None: unknowns.append(θ_sym)
        if d_sym is not None: unknowns.append(d_sym)
        if α_sym is not None: unknowns.append(α_sym)

    # attempt symbolic solve
    try:
        solutions = solve(eqs, unknowns, dict=True)
    except Exception as exc:
        raise ValueError("Symbolic solve failed or too complex for closed-form") from exc

    if not solutions:
        raise ValueError("No closed-form solution found")

    sol = solutions[0]  # pick first solution

    # build result with numerical values filled in
    result: List[DHParam] = []
    for p, (θ_sym, d_sym, α_sym) in zip(dh_params, joint_syms):
        θ_val = float(sol[θ_sym]) if θ_sym in sol else p.theta
        d_val = float(sol[d_sym]) if d_sym in sol else p.d
        α_val = float(sol[α_sym]) if α_sym in sol else p.alpha
        result.append(DHParam(theta=θ_val, d=d_val, a=p.a, alpha=α_val))

    return result

if __name__ == "__main__":
    from math import pi

    # ─── USER CONFIGURATION ───────────────────────────────────────────────
    # Edit this list: add or remove DHParam(...) entries as needed.
    params = [
        # DHParam(theta,    d,    a,    alpha)
        DHParam(theta=0.0, d=0.0, a=0.0, alpha=None),  # example: both θ1 and α1 unknown
        DHParam(theta=None, d=0.0, a=1.0, alpha=0.0),   # θ2 unknown
        DHParam(theta=None, d=0.0, a=1.0, alpha=0.0),  # θ3 and α3 unknown
    ]

    # Option A: target position only
    target_pos    = [1.5, 0.5, 0.0]
    target_matrix = None

    # Option B: full target transform (uncomment to use)
    # from sympy import Matrix
    # target_pos = None
    # target_matrix = Matrix([
    #     [1, 0, 0, 1.5],
    #     [0, 1, 0, 0.5],
    #     [0, 0, 1, 0.0],
    #     [0, 0, 0, 1  ]
    # ])

    # ─── SOLVE IK ──────────────────────────────────────────────────────────
    try:
        solution = solve_closed_ik(params, target_pos=target_pos, target_matrix=target_matrix)
        print("Solved DH parameters:")
        for i, link in enumerate(solution, start=1):
            print(f"  Link {i}: θ = {link.theta}, d = {link.d}, α = {link.alpha}, a = {link.a}")
    except ValueError as err:
        print("IK Error:", err)
